command /console [<text>]:
    permission: op
    permission message: <#ef4444>Access Denied. <#94a3b8>This command is restricted to System Admins.
    description: Executes a command directly from the server console.
    trigger:
        if arg-1 is not set:
            send "<#3b82f6>[OptiCore] <#94a3b8>Usage: /console <command>"
            stop
        
        # 1. Capture the command
        set {_cmd} to arg-1
        
        # 2. Log it for security (so you know who used the console)
        log "[OptiCore] %player% executed via /console: %{_cmd}%" to "console_proxy.log"
        
        # 3. Execute as Console
        execute console command "%{_cmd}%"
        
        # 4. Success Feedback
        send "<#3b82f6>[OptiCore] <#e5e7eb>Command dispatched to system core."
        send "<#94a3b8>Executed: <#facc15>/%{_cmd}%"