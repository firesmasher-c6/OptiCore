import:
    java.net.URL
    java.net.HttpURLConnection
    java.io.OutputStreamWriter
    java.io.BufferedReader
    java.io.InputStreamReader
    org.bukkit.Bukkit

# --- ⚙️ STANDALONE TAB COMPLETION ENGINE ---
on tab complete of "/report":
    set tab completions for position 1 to "bug" and "issue"
    set tab completions for position 2 to "<issue/description>"

# --- ⚙️ THE UNIFIED DISCORD REPORTING MODULE ---
command /report [<text>] [<text>]:
    permission: admin.opticore
    trigger:
        if arg-1 is not set:
            send "&c[OptiCore] Usage: /report [bug|issue] [description/details]" to player
            stop
            
        if arg-2 is not set:
            send "&c[OptiCore] Please provide a description for your %arg-1% report." to player
            stop

        if arg-1 is "bug" or "issue":
            send "&b[OptiCore] Processing report data payload..." to player
            
            # 1. Grab snapshot info instantly using direct Bukkit calls
            set {_player} to player's name
            set {_clean_desc} to arg-2
            replace all """" with "''" in {_clean_desc}
            replace all "\" with "\\" in {_clean_desc}
            
            # Dynamically grab the software and version details separately
            set {_server_version} to Bukkit.getMinecraftVersion()
            set {_server_software} to Bukkit.getName() 

            if arg-1 is "bug":
                set {_color} to "16711680" # Red
                set {_title} to "🚨 New Bug Report Received"
            else:
                set {_color} to "16761095" # Yellow/Orange
                set {_title} to "💡 New Issue Tracking Update"

            set {_mention} to "<@1491710922547400844>"

            # 2. Fire the network post inside the isolated executor function
            m_send_async_post({_player}, {_clean_desc}, {_server_software}, {_server_version}, {_color}, {_title}, {_mention})
            
            send "&a[OptiCore] Success! Your report has been dispatched smoothly." to player
            stop

        send "&c[OptiCore] Invalid category. Use /report bug or /report issue." to player

# --- ⚙️ ISOLATED NETWORK EXECUTOR ---
function m_send_async_post(player: text, desc: text, software: text, version: text, color: text, title: text, mention: text):
    
    # 3. Build the precise raw JSON data string payload (IP completely removed, Software & Version separated)
    set {_json} to "{"
    set {_json} to "%{_json}%""content"": ""%{_mention}%"","
    set {_json} to "%{_json}%""embeds"": [{"
    set {_json} to "%{_json}%""title"": ""%{_title}%"","
    set {_json} to "%{_json}%""color"": %{_color}%,"
    set {_json} to "%{_json}%""fields"": ["
    set {_json} to "%{_json}%{""name"": ""👤 Reporter"", ""value"": ""`%{_player}%`"", ""inline"": true},"
    set {_json} to "%{_json}%{""name"": ""📦 Version"", ""value"": ""`%{_version}%`"", ""inline"": true},"
    set {_json} to "%{_json}%{""name"": ""⚙️ Software"", ""value"": ""`%{_software}%`"", ""inline"": true},"
    set {_json} to "%{_json}%{""name"": ""📝 Description / Details"", ""value"": ""%{_desc}%"", ""inline"": false}"
    set {_json} to "%{_json}%],"
    set {_json} to "%{_json}%""footer"": {""text"": ""OptiCore Engine v3.1""}"
    set {_json} to "%{_json}%}]"
    set {_json} to "%{_json}%}"

    # 4. Secure Webhook Delivery Pipeline
    set {_webhook} to "https://discord.com/api/webhooks/1505169997901856832/PKk3qTJ1D3DUEawoeiMp1qcmVRUcrf-NoizjqvF0RnFQPlN4o8HGjuaIcGZMCcBL6m_s"
    set {_url} to new URL({_webhook})
    set {_connection} to {_url}.openConnection()
    {_connection}.setDoOutput(true)
    {_connection}.setDoInput(true)
    {_connection}.setRequestMethod("POST")
    {_connection}.setConnectTimeout(4000)
    {_connection}.setRequestProperty("Content-Type", "application/json")
    {_connection}.setRequestProperty("User-Agent", "Mozilla/5.0")
    
    set {_writer} to new OutputStreamWriter({_connection}.getOutputStream(), "UTF-8")
    {_writer}.write({_json})
    {_writer}.flush()
    {_writer}.close()
    
    set {_response} to {_connection}.getResponseCode()
    {_connection}.disconnect()